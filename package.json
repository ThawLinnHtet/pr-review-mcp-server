{
  "name": "pr-review-mcp",
  "version": "1.0.0",
  "description": "MCP server for pull request review — static analysis rules + optional LLM review via OpenRouter or any OpenAI-compatible API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "bin": {
    "pr-review-mcp": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pr-review",
    "code-review",
    "pull-request",
    "static-analysis",
    "ai-review",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@octokit/rest": "^21.1.0",
    "diff": "^7.0.0",
    "dotenv": "^17.4.2",
    "openai": "^4.86.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.1",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
